# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает (П7).

# Какой бэкенд LLM использовать: gigachat | ollama | fake
# fake — офлайн-заглушка: без сети и ключей, для отладки. Сдавать на ней нельзя.
LLM_BACKEND=gigachat

# Сбер GigaChat: авторизационные данные из личного кабинета
GIGACHAT_CREDENTIALS=
GIGACHAT_MODEL=GigaChat
# Учебные контуры часто с самоподписанным сертификатом
GIGACHAT_VERIFY_SSL=false

# Локальный инференс через Ollama (фолбэк, когда API недоступен)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:1.5b

# Токен сообщества VK для бота
VK_TOKEN=
